rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSuspended() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('suspended', false) == true;
    }

    function isAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'super-admin']
        && !isSuspended();
    }

    function isSuperAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super-admin'
        && !isSuspended();
    }

    // Members: admin read/update only. Registration verification and claiming go
    // through Admin SDK routes now (app/api/register/*); the remaining client write
    // path is the admin "reset membership" action (app/dashboard/admin/users).
    match /members/{memberId} {
      allow read, update: if isAdmin();
      allow create, delete: if false;
    }

    // Users: owner can read their own doc even while suspended (so the app can
    // detect it and self-log-out with a message instead of a permission error).
    // Owner cannot change role, mhspNumber, created_at, suspended, or email
    // (server/admin only) and cannot write at all while suspended. Admins can read
    // all user docs. Email is excluded here so it can never drift from the Firebase
    // Auth login email — changing it goes through app/api/account/update-email
    // (Admin SDK), which updates both together, gated on a reauthenticated password check.
    match /users/{userId} {
      allow read: if request.auth != null
        && (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null
        && request.auth.uid == userId
        && !isSuspended()
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['role', 'mhspNumber', 'created_at', 'suspended', 'email']);
    }

    // Networks: legacy membership docs. The app now treats networks as fixed
    // categories (lib/networks.js) with per-user favorites on users/{uid}, so
    // nothing client-side writes these anymore — admin-only, read allowed for
    // any authenticated, non-suspended user.
    match /networks/{networkId} {
      allow read: if request.auth != null && !isSuspended();
      allow update: if isAdmin();
      allow create, delete: if false;
    }

    // Rides: readable by any authenticated, non-suspended user; driver owns create/delete.
    // The driver and admins can update any field. Any other authenticated, non-suspended
    // user (a passenger booking/canceling) can only touch available_seats/passengers —
    // not departure, times, driver info, or anything else on the ride.
    match /rides/{rideId} {
      allow read: if request.auth != null && !isSuspended();
      allow create: if request.auth != null
        && !isSuspended()
        && request.resource.data.driverId == request.auth.uid;
      allow update: if request.auth != null
        && !isSuspended()
        && (resource.data.driverId == request.auth.uid
            || isAdmin()
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['available_seats', 'passengers']));
      allow delete: if request.auth != null
        && !isSuspended()
        && (resource.data.driverId == request.auth.uid || isAdmin());
    }

    // Bookings: readable by passenger, driver, or admin; writable by passenger or driver (unless suspended)
    match /bookings/{bookingId} {
      allow read: if request.auth != null
        && (resource.data.passengerId == request.auth.uid
            || resource.data.driver.id == request.auth.uid
            || isAdmin());
      allow create: if request.auth != null
        && !isSuspended()
        && request.resource.data.passengerId == request.auth.uid;
      allow update: if request.auth != null
        && !isSuspended()
        && (resource.data.passengerId == request.auth.uid
            || resource.data.driver.id == request.auth.uid);
      allow delete: if false;
    }

    // Feedback: anyone can submit; admins can read/update; only super-admins can delete
    match /feedback/{id} {
      allow create: if true;
      allow read, update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    // Activity log: any authenticated, non-suspended user may log their own actions;
    // only admins can read the log or modify/delete existing entries
    match /activity_log/{id} {
      allow read: if isAdmin();
      allow create: if request.auth != null
        && !isSuspended()
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Locations & drive times: runtime-managed replacement for the old static
    // lib/locations.js / lib/drive-times.js files (issue #66). Read allowed for
    // any authenticated, non-suspended user (needed for ride-offer dropdowns);
    // writes only happen through admin API routes via the Admin SDK.
    match /locations/{id} {
      allow read: if request.auth != null && !isSuspended();
      allow write: if false;
    }

    match /driveTimes/{id} {
      allow read: if request.auth != null && !isSuspended();
      allow write: if false;
    }

    // Maintenance mode (app/dashboard/admin/settings, issue #108): publicly
    // readable since signed-out visitors on the landing/login page must see it
    // too. Writes only happen through the admin API route via the Admin SDK.
    // More specific than the config/{id} rule below, so it takes precedence
    // for this one document.
    match /config/maintenance {
      allow read: if true;
      allow write: if false;
    }

    // System settings (app/dashboard/admin/settings): super-admin only (issue #107)
    match /config/{id} {
      allow read, write: if isSuperAdmin();
    }

    // System message banner (app/dashboard/admin/settings, issue #106): publicly
    // readable since the login page must show it to signed-out visitors too.
    // Writes only happen through admin API routes via the Admin SDK, which also
    // enforce the non-overlap validation Firestore rules can't express across documents.
    match /system_messages/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /import_sessions/{id} {
      allow read, write: if false;
    }

    // Rate limit counters: Admin SDK only, never touched by client SDKs
    match /rate_limits/{id} {
      allow read, write: if false;
    }

    // Registration verification codes: Admin SDK only, never touched by client SDKs
    match /registration_verifications/{id} {
      allow read, write: if false;
    }

    // Password reset tokens: Admin SDK only, never touched by client SDKs
    match /password_resets/{id} {
      allow read, write: if false;
    }
  }
}
